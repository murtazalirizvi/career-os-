# ── Career OS — Railway Production Dockerfile ────────────────────────────────
# Build context: repo root (copies both Backend/ and Frontend/)
FROM python:3.12-slim

WORKDIR /app

# Minimal system deps — only build tools needed for compiled Python packages
# opencv-python-headless bundles its own GL/glib libs, no system GL needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (layer cache — copy requirements first)
COPY Backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY Backend/ .

# Copy frontend so FastAPI serves it as static files at /
COPY Frontend/ /Frontend

# Persistent data directories
RUN mkdir -p data/uploads data/reports

# Railway injects $PORT at runtime; default 8000 for local docker run
ENV PORT=8000

EXPOSE $PORT

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]

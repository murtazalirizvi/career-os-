# Career OS — Backend Environment Variables
# Copy this file to .env and fill in your values

# ── AI / LLM Keys ──────────────────────────────────────────────────────────
# Google Gemini — enables AI narrative suggestions in Feature 5
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# AssemblyAI — enables audio transcription in Feature 2
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Job Market Data ─────────────────────────────────────────────────────────
# Adzuna — enables live job market data in Feature 3
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Reed — enables additional job market data in Feature 3
REED_API_KEY=your_reed_api_key_here

# ── Security ────────────────────────────────────────────────────────────────
# Secret used to hash session tokens — change this in production!
CAREER_OS_AUTH_SECRET=career-os-dev-secret-change-me

# ── Database ────────────────────────────────────────────────────────────────
# SQLite path (default) — change to postgres:// for production
DATABASE_URL=sqlite:///./data/career_os.db

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty for wildcard)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
